// CRM Formation - Schéma de données

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Entite {
  id          String       @id @default(cuid())
  code        String       @unique
  nom         String
  specialite  String
  ville       String
  formations  Formation[]
  candidats   Candidat[]
  entreprises Entreprise[]
  evenements  Evenement[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Formation {
  id                   String  @id @default(cuid())
  intitule             String
  codeRNCP             String?
  niveau               String
  type                 String
  voieAcces            String
  montant              Float?
  dureeMois            Int?
  rythme               String?
  secteurs             String?
  metiers              String?
  competences          String?
  debouches            String?
  prerequis            String?
  financements         String?
  aidesEmployeur       String?
  tauxReussite         Float?
  tauxInsertion        Float?
  argumentsCommerciaux String?

  entiteId String?
  entite   Entite? @relation(fields: [entiteId], references: [id])

  domaine  String?
  codeRS   String?

  candidats Candidat[]
  actions   ActionFormation[]
  offres    OffreAlternance[]
  deals     Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Candidat {
  id            String    @id @default(cuid())
  nom           String
  prenom        String
  email         String?
  telephone     String?
  telephoneSecondaire String?
  adresse       String?
  ville         String?
  codePostal    String?
  pays          String?   @default("France")
  dateNaissance DateTime?
  age           Int?
  genre         String?
  nationalite   String?

  sourceEntree     String?
  prescripteur     String?
  dateCandidature  DateTime?
  derniereActivite DateTime?
  statutLead       String?    @default("froid")
  scoreLead        Int?       @default(0)
  persona          String?

  etapePipeline Int    @default(1)
  statut        String @default("nouveau")

  scorePositionnement Int?
  bilanPositionnement String?
  ficheAdaptation     String?
  motivationNote      Int?

  formationId      String?
  formation        Formation? @relation(fields: [formationId], references: [id])
  niveauActuel     String?
  niveauVise       String?
  situation        String?
  experiencePro    String?
  diplomeActuel    String?
  anneeBac         Int?

  statutPro            String?
  ancienneteSalarie    String?
  reconversion         Boolean? @default(false)
  financementChoisi    String?
  montantFinancement   Float?
  opco                 String?
  numeroDossierOpco    String?
  consentDevis         Boolean? @default(false)

  formationManuelleNom    String?
  formationManuelleNiveau String?

  posteVise               String?
  formationSouhaiteeLibre String?
  apiSource               String?
  apiCandidatureId        String?

  societeMatcheeId  String?
  societeMatchee    Entreprise? @relation("CandidatSociete", fields: [societeMatcheeId], references: [id])
  societesProposees String?
  typeContratSouhaite String?

  entiteId String?
  entite   Entite? @relation(fields: [entiteId], references: [id])

  mobiliteGeo  String?
  permisB      Boolean? @default(false)
  vehicule     Boolean? @default(false)
  niveauAnglais String?
  niveauInformatique String?
  handicap     Boolean? @default(false)
  rqth         Boolean? @default(false)

  consentRgpd       Boolean? @default(false)
  consentNewsletter Boolean? @default(false)
  consentSms        Boolean? @default(false)
  consentAppel      Boolean? @default(false)

  conseillerDedie String?
  conseillerLead  String?
  dateRelance     DateTime?

  linkedinUrl String?
  cv          String?
  lettreMotivation String?
  pieceIdentite    String?

  notes String?

  contrats       Contrat[]
  taches         Tache[]
  documents      Document[]
  evenements     Evenement[]     @relation("CandidatEvenement")
  communications Communication[]
  deals          Deal[]
  notesObjet     Note[]
  meetings       Meeting[]
  tickets        Ticket[]
  activites      Activite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Entreprise {
  id             String  @id @default(cuid())
  raisonSociale  String
  siret          String? @unique
  siren          String?
  naf            String?
  codeApe        String?
  numTVA         String?
  formeJuridique String?
  taille         String?
  effectif       Int?
  chiffreAffaires Float?
  capitalSocial  Float?
  secteur        String?
  secteurDetail  String?

  adresse           String?
  complementAdresse String?
  ville             String?
  codePostal        String?
  pays              String? @default("France")
  telephoneStandard String?
  email             String?
  siteWeb           String?
  linkedinUrl       String?

  adresseFacturation String?
  villeFacturation   String?
  cpFacturation      String?

  persona String?

  etapePipeline  Int    @default(1)
  statut         String @default("prospect")
  scorePotentiel Int?
  derniereActivite DateTime?

  sourceDetection String?
  urlOffre        String?

  rechercheAlternants      Boolean? @default(false)
  rechercheCDI             Boolean? @default(false)
  rechercheCDD             Boolean? @default(false)
  rechercheStage           Boolean? @default(false)
  rechercheFormationSalaries Boolean? @default(false)
  typeAlternance           String?
  nbAlternantsRecherches   Int?
  nbCDIRecherches          Int?
  dateBesoinAlternance     DateTime?
  niveauxRecherches        String?
  metiersRecherches        String?

  conventionCollective String?
  opcoRattache         String?
  accordOPCO           Boolean? @default(false)
  accordTutorat        Boolean? @default(false)

  responsableRHNom      String?
  responsableRHEmail    String?
  responsableRHTelephone String?
  dirigeantNom          String?
  dirigeantEmail        String?

  commercialDedie String?

  entiteId String?
  entite   Entite? @relation(fields: [entiteId], references: [id])

  contacts       Contact[]
  offres         OffreAlternance[]
  contrats       Contrat[]
  taches         Tache[]
  documents      Document[]
  evenements     Evenement[]       @relation("EntrepriseEvenement")
  communications Communication[]
  deals          Deal[]
  notesObjet     Note[]
  meetings       Meeting[]
  tickets        Ticket[]
  activites      Activite[]
  candidatsMatches Candidat[]      @relation("CandidatSociete")

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id                 String  @id @default(cuid())
  prenom             String
  nom                String
  email              String?
  telephone          String?
  fonction           String?
  estMaitreApp       Boolean @default(false)
  nbApprentisActuels Int     @default(0)

  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OffreAlternance {
  id            String    @id @default(cuid())
  intitulePoste String
  missions      String?
  niveau        String?
  rythme        String?
  dateDemarrage DateTime?
  localisation  String?

  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  formationId String?
  formation   Formation? @relation(fields: [formationId], references: [id])

  statut String @default("ouverte")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActionFormation {
  id        String   @id @default(cuid())
  intitule  String
  dateDebut DateTime
  dateFin   DateTime
  lieu      String?
  nbPlaces  Int?

  formationId String
  formation   Formation @relation(fields: [formationId], references: [id])

  contrats Contrat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contrat {
  id           String   @id @default(cuid())
  type         String
  dateDebut    DateTime
  dateFin      DateTime
  remuneration Float?
  opco         String?
  numeroCERFA  String?

  candidatId String
  candidat   Candidat @relation(fields: [candidatId], references: [id])

  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id])

  actionFormationId String?
  actionFormation   ActionFormation? @relation(fields: [actionFormationId], references: [id])

  maitreAppContactId String?

  statut String @default("brouillon")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tache {
  id          String    @id @default(cuid())
  titre       String
  description String?
  type        String
  priorite    String    @default("normale")
  statut      String    @default("a_faire")
  echeance    DateTime?
  assigneA    String?

  candidatId String?
  candidat   Candidat? @relation(fields: [candidatId], references: [id])

  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id])

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Evenement {
  id          String   @id @default(cuid())
  titre       String
  type        String
  date        DateTime
  lieu        String?
  description String?

  entiteId String?
  entite   Entite? @relation(fields: [entiteId], references: [id])

  candidats   Candidat[]   @relation("CandidatEvenement")
  entreprises Entreprise[] @relation("EntrepriseEvenement")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id         String  @id @default(cuid())
  numero     Int
  type       String
  nom        String
  periode    String
  statut     String  @default("manquant")
  source     String?
  urlFichier String?

  candidatId String?
  candidat   Candidat? @relation(fields: [candidatId], references: [id])

  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Communication {
  id         String   @id @default(cuid())
  canal      String
  direction  String
  sujet      String?
  contenu    String?
  dateAction DateTime @default(now())

  candidatId String?
  candidat   Candidat? @relation(fields: [candidatId], references: [id])

  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id])
}

model Veille {
  id              String    @id @default(cuid())
  titre           String
  resume          String?
  source          String
  urlSource       String?
  theme           String?
  niveauImpact    String    @default("info")
  datePublication DateTime?
  createdAt       DateTime  @default(now())
}

model Deal {
  id             String    @id @default(cuid())
  titre          String
  type           String    @default("apprentissage")
  montant        Float?
  devise         String    @default("EUR")
  probabilite    Int       @default(50)
  dateOuverture  DateTime  @default(now())
  dateClotPrevue DateTime?
  dateCloture    DateTime?
  dateGagne      DateTime?
  ownerName      String?
  centreCode     String?

  pipelineId String?
  pipeline   DealPipeline? @relation(fields: [pipelineId], references: [id])
  etapeCle   String

  statut String @default("ouverte")

  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id])
  candidatId   String?
  candidat     Candidat?   @relation(fields: [candidatId], references: [id])
  formationId  String?
  formation    Formation?  @relation(fields: [formationId], references: [id])

  devisEnvoyeLe       DateTime?
  devisValideLe       DateTime?
  financementEnvoyeLe DateTime?
  financementAccordeLe DateTime?
  entreeFormationLe   DateTime?
  finFormationLe      DateTime?

  notes    Note[]
  meetings Meeting[]
  taches   Tache[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DealPipeline {
  id        String   @id @default(cuid())
  nom       String
  stages    String
  isDefault Boolean  @default(false)
  deals     Deal[]
  createdAt DateTime @default(now())
}

model Note {
  id           String      @id @default(cuid())
  contenu      String
  auteur       String?
  candidatId   String?
  candidat     Candidat?   @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  dealId       String?
  deal         Deal?       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  ticketId     String?
  ticket       Ticket?     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
}

model Meeting {
  id          String   @id @default(cuid())
  titre       String
  description String?
  dateDebut   DateTime
  dateFin     DateTime
  lieu        String?
  type        String   @default("entretien")
  statut      String   @default("planifie")
  ownerName   String?

  candidatId   String?
  candidat     Candidat?   @relation(fields: [candidatId], references: [id])
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id])
  dealId       String?
  deal         Deal?       @relation(fields: [dealId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id          String  @id @default(cuid())
  sujet       String
  description String?
  categorie   String?
  priorite    String  @default("normale")
  statut      String  @default("nouveau")
  ownerName   String?
  source      String?

  candidatId   String?
  candidat     Candidat?   @relation(fields: [candidatId], references: [id])
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id])
  notes        Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Formulaire {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  nom         String
  description String?
  champs      String
  cibleObjet  String                 @default("candidat")
  entiteId    String?
  formationId String?
  active      Boolean                @default(true)
  submissions FormulaireSubmission[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model FormulaireSubmission {
  id           String     @id @default(cuid())
  formulaireId String
  formulaire   Formulaire @relation(fields: [formulaireId], references: [id], onDelete: Cascade)
  donnees      String
  candidatId   String?
  entrepriseId String?
  createdAt    DateTime   @default(now())
}

model Liste {
  id          String   @id @default(cuid())
  nom         String
  description String?
  objet       String
  type        String   @default("dynamique")
  filtres     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailTemplate {
  id        String   @id @default(cuid())
  nom       String
  sujet     String
  contenu   String
  categorie String?
  variables String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PropPersonnalisee {
  id        String   @id @default(cuid())
  objet     String
  cle       String
  libelle   String
  type      String
  options   String?
  ordre     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([objet, cle])
}

model PropValeur {
  id        String   @id @default(cuid())
  propCle   String
  objet     String
  objetId   String
  valeur    String?
  createdAt DateTime @default(now())

  @@unique([propCle, objet, objetId])
}

model Utilisateur {
  id         String   @id @default(cuid())
  email      String   @unique
  nom        String
  prenom     String?
  role       String   @default("commercial")
  entiteCode String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Activite {
  id           String      @id @default(cuid())
  type         String
  titre        String
  contenu      String?
  auteur       String?
  candidatId   String?
  candidat     Candidat?   @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  dealId       String?
  createdAt    DateTime    @default(now())
}

model Workflow {
  id          String   @id @default(cuid())
  nom         String
  description String?
  declencheur String
  objet       String
  conditions  String   @default("[]")
  actions     String
  active      Boolean  @default(true)
  nbExecutions Int     @default(0)
  derniereExe DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sequence {
  id          String               @id @default(cuid())
  nom         String
  description String?
  cibleObjet  String               @default("candidat")
  etapes      String
  active      Boolean              @default(true)
  enrollments SequenceEnrollment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model SequenceEnrollment {
  id            String   @id @default(cuid())
  sequenceId    String
  sequence      Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  candidatId    String?
  entrepriseId  String?
  etapeCourante Int      @default(0)
  statut        String   @default("active")
  enrolledAt    DateTime @default(now())
}

model Campaign {
  id              String    @id @default(cuid())
  nom             String
  sujet           String
  contenu         String
  listeId         String?
  templateId      String?
  statut          String    @default("brouillon")
  dateEnvoi       DateTime?
  nbDestinataires Int       @default(0)
  nbOuvertures    Int       @default(0)
  nbClics         Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Quote {
  id           String    @id @default(cuid())
  numero       String    @unique
  titre        String
  lignes       String
  totalHT      Float     @default(0)
  tva          Float     @default(20)
  totalTTC     Float     @default(0)
  statut       String    @default("brouillon")
  dateEmission DateTime  @default(now())
  dateValidite DateTime?
  dealId       String?
  entrepriseId String?
  candidatId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ImportLog {
  id         String   @id @default(cuid())
  objet      String
  nomFichier String?
  nbLignes   Int
  nbCrees    Int      @default(0)
  nbErreurs  Int      @default(0)
  statut     String   @default("termine")
  detail     String?
  auteur     String?
  createdAt  DateTime @default(now())
}

model Equipe {
  id          String   @id @default(cuid())
  nom         String
  description String?
  couleur     String?
  entiteCode  String?
  membres     String?
  createdAt   DateTime @default(now())
}

model Snippet {
  id        String   @id @default(cuid())
  raccourci String   @unique
  titre     String
  contenu   String
  auteur    String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  acteur    String
  action    String
  objet     String
  objetId   String?
  detail    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Integration {
  id          String   @id @default(cuid())
  cle         String   @unique
  nom         String
  description String?
  categorie   String?
  active      Boolean  @default(false)
  config      String?
  derniereSync DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MaPreference {
  id              String   @id @default(cuid())
  utilisateurId   String   @unique
  langue          String   @default("fr")
  fuseau          String   @default("Europe/Paris")
  theme           String   @default("clair")
  emailNotifs     Boolean  @default(true)
  inAppNotifs     Boolean  @default(true)
  digestHebdo     Boolean  @default(true)
  signature       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AccountConfig {
  id              String   @id @default("singleton")
  nomGroupe       String   @default("Groupe CFA")
  logoUrl         String?
  fuseau          String   @default("Europe/Paris")
  langue          String   @default("fr")
  deviseDefaut    String   @default("EUR")
  couleurPrimaire String   @default("#FF7A59")
  couleurSecondaire String @default("#2E3A4F")
  domaineEmail    String?
  signatureGlobale String?
  rgpdContact     String   @default("dpo@groupe-cfa.fr")
  rgpdAdresse     String?
  updatedAt       DateTime @updatedAt @default(now())
}
